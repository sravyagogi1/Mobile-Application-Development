<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#cad2fa"
    tools:context=".MainActivity"
    >

    <TextView
        android:id="@+id/topleft_textview"
        android:layout_width="@dimen/length"
        android:layout_height="@dimen/length"
        android:text="@string/top_left"
        android:tag="topLeft"
        android:gravity="center"
        android:textSize="@dimen/textSize"
        android:textColor="#654ea3"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintTop_toTopOf="parent" />
    <TextView
        android:id="@+id/topright_textview"
        android:layout_width="@dimen/length"
        android:layout_height="@dimen/length"
        android:text="@string/top_right"
        android:tag="topRight"
        android:gravity="center"
        android:textSize="@dimen/textSize"
        android:textColor="#654ea3"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="parent" />
    <androidx.appcompat.widget.AppCompatButton
        android:id="@+id/bottomleft_button"
        android:layout_width="@dimen/length"
        android:layout_height="@dimen/length"
        android:text="@string/bottom_left"
        android:tag="bottomLeft"
        android:textSize="@dimen/textSize"
        android:backgroundTint="#ad9ff5"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toLeftOf="parent"
        />
    <androidx.appcompat.widget.AppCompatButton
        android:id="@+id/bottomRight_button"
        android:layout_width="@dimen/length"
        android:layout_height="@dimen/length"
        android:text="@string/bottom_right"
        android:tag="bottomRight"
        android:textSize="@dimen/textSize"
        android:backgroundTint="#ad9ff5"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        />
    <androidx.appcompat.widget.AppCompatSeekBar
        android:id="@+id/seekbar"
        android:min="5"
        android:max="100"
        android:progress="30"
        android:progressTint="@color/black"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toLeftOf="parent"/>

    <ImageView
        android:id="@+id/myImage"
        android:layout_width="200dp"
        android:layout_height="200dp"
        android:src="@drawable/bluelily"
        app:layout_constraintHorizontal_bias="0.497"
        app:layout_constraintVertical_bias=".28"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"/>

    <ImageView
        android:id="@+id/myImage2"
        android:layout_width="300dp"
        android:layout_height="300dp"
        android:src="@drawable/bluelily2"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias=".75"
        app:layout_constraintEnd_toStartOf="@id/bottomRight_button" />

    <ImageView
        android:id="@+id/myImage3"
        android:layout_width="200dp"
        android:layout_height="200dp"
        android:src="@drawable/bluelily3"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintHorizontal_bias="0.9"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias=".7" />

</androidx.constraintlayout.widget.ConstraintLayout>