<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#743a27"
    tools:context=".MainActivity">

    <Button
        android:id="@+id/AddOrnament"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="Add Ornament"
        android:backgroundTint="#ffbe4a"
        android:padding="12dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintVertical_bias="0.02"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toStartOf="@id/AddPresent" />

    <Button
        android:id="@+id/AddPresent"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="Add Present"
        android:backgroundTint="#ffbe4a"
        android:padding="12dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintVertical_bias="0.02"
        app:layout_constraintStart_toEndOf="@id/AddOrnament"
        app:layout_constraintEnd_toStartOf="@id/RemoveAll" />

    <Button
        android:id="@+id/RemoveAll"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="Remove All"
        android:backgroundTint="#ffbe4a"
        android:padding="12dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintVertical_bias="0.02"
        app:layout_constraintStart_toEndOf="@id/AddPresent"
        app:layout_constraintEnd_toEndOf="parent" />

    <view
        android:id="@+id/drawView"
        class = "com.sravyagogineni.lab08.DrawView"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintTop_toBottomOf="@id/AddPresent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        tools:ignore="MissingClass" />
</androidx.constraintlayout.widget.ConstraintLayout>